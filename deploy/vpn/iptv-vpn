#!/usr/bin/env python3
"""EasyIPTVBox remote access helper (runs as root via sudo).

WireGuard VPN that gives phones access to THIS box only (no routing into the
home network), plus a DuckDNS updater.

    iptv-vpn setup                 create server keys + /etc/wireguard/wg0.conf
    iptv-vpn enable|disable        start/stop wg0 and the DuckDNS timer
    iptv-vpn add <name>            new device; prints its client config
    iptv-vpn remove <name>
    iptv-vpn status                JSON status
    iptv-vpn set-duckdns <domain>  token is read from stdin
    iptv-vpn duckdns-update        update the DuckDNS record now

TCP mode for networks that block WireGuard/UDP (VLESS + Reality via sing-box,
looks like ordinary HTTPS; clients can only reach this box's web app):

    iptv-vpn proxy-enable [port]   install sing-box (pinned + checksum) and start it
    iptv-vpn proxy-disable
    iptv-vpn proxy-add <name> [host]   new device; prints JSON (link + profile)
    iptv-vpn proxy-remove <name>
    iptv-vpn proxy-status          JSON status

State lives in /etc/iptv-vpn (root only).
"""
import hashlib
import ipaddress
import json
import os
import pwd
import platform
import shutil
import tarfile
import tempfile
import urllib.parse
import uuid
import re
import subprocess
import sys
import time
import urllib.request

STATE_DIR = "/etc/iptv-vpn"
STATE = os.path.join(STATE_DIR, "state.json")
WG_CONF = "/etc/wireguard/wg0.conf"
NET = ipaddress.ip_network("10.66.0.0/24")
SERVER_IP = "10.66.0.1"
PORT = 51821
NAME_RE = re.compile(r"^[A-Za-z0-9 _.-]{1,32}$")


def sh(*cmd, inp=None):
    return subprocess.run(cmd, input=inp, capture_output=True, text=True,
                          check=True).stdout.strip()


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"enabled": False, "peers": [], "duckdns": {}}


def save(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600),
              "w") as f:
        json.dump(st, f, indent=1)
    os.replace(tmp, STATE)


def ensure_server(st):
    if not st.get("server_priv"):
        priv = sh("wg", "genkey")
        st["server_priv"] = priv
        st["server_pub"] = sh("wg", "pubkey", inp=priv)
    return st


NFT_RULES = os.path.join(STATE_DIR, "only-this-box.nft")


def write_nft():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    with open(NFT_RULES, "w") as f:
        f.write("table inet iptvvpn {\n"
                "  chain forward_drop {\n"
                "    type filter hook forward priority 0; policy accept;\n"
                "    iifname \"wg0\" drop\n"
                "  }\n"
                "}\n")


def write_wg_conf(st):
    write_nft()
    lines = ["# managed by iptv-vpn - do not edit",
             "[Interface]",
             "Address = %s/24" % SERVER_IP,
             "ListenPort = %d" % PORT,
             "PrivateKey = %s" % st["server_priv"],
             # Only this box is reachable: drop anything a VPN client tries
             # to send through the Pi to other hosts.
             "PostUp = nft -f %s" % NFT_RULES,
             "PostDown = nft delete table inet iptvvpn", ""]
    for p in st["peers"]:
        lines += ["[Peer]", "# %s" % p["name"],
                  "PublicKey = %s" % p["pub"],
                  "PresharedKey = %s" % p["psk"],
                  "AllowedIPs = %s/32" % p["ip"], ""]
    os.makedirs("/etc/wireguard", mode=0o700, exist_ok=True)
    with open(os.open(WG_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600),
              "w") as f:
        f.write("\n".join(lines))


def wg_running():
    return subprocess.run(["ip", "link", "show", "wg0"],
                          capture_output=True).returncode == 0


def reload_wg(st):
    write_wg_conf(st)
    if st.get("enabled"):
        if wg_running():
            stripped = sh("wg-quick", "strip", "wg0")
            subprocess.run(["wg", "syncconf", "wg0", "/dev/stdin"],
                           input=stripped, text=True, check=True)
        else:
            subprocess.run(["systemctl", "enable", "--now", "wg-quick@wg0"],
                           check=True, capture_output=True)


def endpoint(st):
    dom = st.get("duckdns", {}).get("domain")
    return "%s:%d" % (dom or "YOUR-HOME-ADDRESS", PORT)


def client_conf(st, p):
    return "\n".join([
        "[Interface]",
        "PrivateKey = %s" % p["priv"],
        "Address = %s/32" % p["ip"],
        "",
        "[Peer]",
        "PublicKey = %s" % st["server_pub"],
        "PresharedKey = %s" % p["psk"],
        "Endpoint = %s" % endpoint(st),
        # only traffic for the box goes through the VPN
        "AllowedIPs = %s/32" % SERVER_IP,
        "PersistentKeepalive = 25", ""])


def cmd_add(st, name):
    if not NAME_RE.match(name):
        raise SystemExit("bad name")
    if any(p["name"].lower() == name.lower() for p in st["peers"]):
        raise SystemExit("name already used")
    used = {p["ip"] for p in st["peers"]} | {SERVER_IP}
    ip = next(str(h) for h in NET.hosts() if str(h) not in used)
    priv = sh("wg", "genkey")
    p = {"name": name, "ip": ip, "priv": priv,
         "pub": sh("wg", "pubkey", inp=priv), "psk": sh("wg", "genpsk"),
         "created": int(time.time())}
    st["peers"].append(p)
    save(st)
    reload_wg(st)
    print(client_conf(st, p))


def cmd_remove(st, name):
    st["peers"] = [p for p in st["peers"] if p["name"] != name]
    save(st)
    reload_wg(st)


def handshakes():
    out = {}
    if not wg_running():
        return out
    try:
        for line in sh("wg", "show", "wg0", "dump").splitlines()[1:]:
            f = line.split("\t")
            out[f[0]] = int(f[4])
    except Exception:
        pass
    return out


def cmd_status(st):
    hs = handshakes()
    dd = st.get("duckdns", {})
    print(json.dumps({
        "enabled": bool(st.get("enabled")), "running": wg_running(),
        "port": PORT, "server_ip": SERVER_IP, "endpoint": endpoint(st),
        "duckdns": {"domain": dd.get("domain", ""),
                    "has_token": bool(dd.get("token")),
                    "last_ok": dd.get("last_ok", 0),
                    "last_ip": dd.get("last_ip", ""),
                    "last_error": dd.get("last_error", "")},
        "peers": [{"name": p["name"], "ip": p["ip"],
                   "last_handshake": hs.get(p["pub"], 0)}
                  for p in st["peers"]],
    }))


def cmd_duckdns_update(st):
    dd = st.get("duckdns", {})
    if not dd.get("domain") or not dd.get("token"):
        return
    sub = dd["domain"].split(".duckdns.org")[0]
    url = ("https://www.duckdns.org/update?domains=%s&token=%s&verbose=true"
           % (sub, dd["token"]))
    try:
        body = urllib.request.urlopen(url, timeout=20).read().decode()
        lines = body.split("\n")
        if lines[0] == "OK":
            dd["last_ok"] = int(time.time())
            dd["last_ip"] = lines[1] if len(lines) > 1 else ""
            dd["last_error"] = ""
        else:
            dd["last_error"] = "DuckDNS refused the update (check token/domain)"
    except Exception as e:
        dd["last_error"] = "DuckDNS unreachable: %s" % e
    st["duckdns"] = dd
    save(st)


# ---------------------------------------------------------------------------
#  TCP mode: VLESS + Reality (sing-box)
# ---------------------------------------------------------------------------
SB_VERSION = "1.14.4"
SB_SHA256 = {       # official release assets (checked before use)
    "aarch64": ("sing-box-%s-linux-arm64-glibc.tar.gz" % SB_VERSION,
                "241cb4ccbf1a003235f8a969cc25d28cc74487df52721f6de28be7e37eae2ae9"),
    "x86_64": ("sing-box-%s-linux-amd64-glibc.tar.gz" % SB_VERSION,
               "231e57c18378f780a08de832844a1ca9716e17a7bcf82964b350844d243c03ac"),
}
SB_DIR = "/usr/local/lib/iptv-proxy"
SB_BIN = os.path.join(SB_DIR, "sing-box")
SB_CONF_DIR = "/etc/iptv-proxy"
SB_CONF = os.path.join(SB_CONF_DIR, "config.json")
SB_USER = "iptvproxy"
SB_UNIT = "/etc/systemd/system/iptv-proxy.service"
TUNNEL_PORT = 8081          # loopback port of the web app for tunnel traffic
DEFAULT_PROXY_PORT = 8443
DEFAULT_SNI = "www.microsoft.com"


def sb_install():
    if os.path.exists(SB_BIN):
        return
    name, want = SB_SHA256.get(platform.machine(), (None, None))
    if not name:
        raise SystemExit("unsupported CPU: %s" % platform.machine())
    url = "https://github.com/SagerNet/sing-box/releases/download/v%s/%s" % (
        SB_VERSION, name)
    tmp = tempfile.mkdtemp()
    try:
        arc = os.path.join(tmp, name)
        with urllib.request.urlopen(url, timeout=120) as r, open(arc, "wb") as f:
            shutil.copyfileobj(r, f)
        with open(arc, "rb") as f:
            got = hashlib.sha256(f.read()).hexdigest()
        if got != want:
            raise SystemExit("sing-box download failed the checksum, not installed")
        with tarfile.open(arc) as t:
            member = next(m for m in t.getmembers()
                          if m.isfile() and m.name.endswith("/sing-box"))
            member.name = "sing-box"
            t.extract(member, tmp)
        os.makedirs(SB_DIR, mode=0o755, exist_ok=True)
        shutil.copy(os.path.join(tmp, "sing-box"), SB_BIN + ".new")
        os.chmod(SB_BIN + ".new", 0o755)
        os.replace(SB_BIN + ".new", SB_BIN)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def proxy_state(st):
    return st.setdefault("proxy", {"enabled": False, "users": []})


def sb_keys(px):
    if not px.get("priv"):
        out = sh(SB_BIN, "generate", "reality-keypair")
        kv = dict(l.split(": ", 1) for l in out.splitlines() if ": " in l)
        px["priv"], px["pub"] = kv["PrivateKey"].strip(), kv["PublicKey"].strip()
    if not px.get("short_id"):
        px["short_id"] = sh(SB_BIN, "generate", "rand", "4", "--hex")
    px.setdefault("port", DEFAULT_PROXY_PORT)
    px.setdefault("sni", DEFAULT_SNI)


def sb_config(px):
    """Server config: VLESS+Reality in, only the box's web app out."""
    return {
        "log": {"level": "warn"},
        "inbounds": [{
            "type": "vless", "tag": "in", "listen": "::",
            "listen_port": int(px["port"]),
            "users": [{"name": u["name"], "uuid": u["uuid"],
                       "flow": "xtls-rprx-vision"} for u in px["users"]],
            "tls": {"enabled": True, "server_name": px["sni"],
                    "reality": {"enabled": True,
                                "handshake": {"server": px["sni"],
                                              "server_port": 443},
                                "private_key": px["priv"],
                                "short_id": [px["short_id"]]}}}],
        "outbounds": [{"type": "direct", "tag": "box"}],
        "route": {"rules": [
            # the only thing a client can reach: the box's web app, which is
            # redirected to its own loopback port (treated as remote access)
            {"inbound": ["in"], "ip_cidr": [SERVER_IP + "/32"], "port": [8080],
             "action": "route-options", "override_address": "127.0.0.1",
             "override_port": TUNNEL_PORT},
            {"inbound": ["in"], "ip_cidr": ["127.0.0.1/32"],
             "port": [TUNNEL_PORT], "action": "route", "outbound": "box"},
            {"inbound": ["in"], "action": "reject"}]},
    }


def sb_write(px):
    os.makedirs(SB_CONF_DIR, mode=0o750, exist_ok=True)
    try:
        gid = pwd.getpwnam(SB_USER).pw_gid
    except KeyError:
        gid = 0
    tmp = SB_CONF + ".new"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640),
              "w") as f:
        json.dump(sb_config(px), f, indent=1)
    os.chown(tmp, 0, gid)
    os.chown(SB_CONF_DIR, 0, gid)
    subprocess.run([SB_BIN, "check", "-c", tmp], check=True,
                   capture_output=True)
    os.replace(tmp, SB_CONF)


SB_UNIT_TEXT = """[Unit]
Description=EasyIPTVBox TCP remote access (sing-box, VLESS+Reality)
After=network-online.target
Wants=network-online.target

[Service]
User=%s
ExecStart=%s run -c %s
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
""" % (SB_USER, SB_BIN, SB_CONF)


def proxy_running():
    return subprocess.run(["systemctl", "is-active", "--quiet",
                           "iptv-proxy.service"]).returncode == 0


def proxy_apply(st, restart=False):
    px = proxy_state(st)
    sb_write(px)
    if px.get("enabled"):
        subprocess.run(["systemctl", "daemon-reload"], capture_output=True)
        subprocess.run(["systemctl", "enable", "iptv-proxy.service"],
                       capture_output=True)
        if proxy_running() and not restart:
            subprocess.run(["systemctl", "reload", "iptv-proxy.service"],
                           capture_output=True)
        else:
            subprocess.run(["systemctl", "restart", "iptv-proxy.service"],
                           check=True, capture_output=True)


def cmd_proxy_enable(st, args):
    px = proxy_state(st)
    if args:
        port = int(args[0])
        if not 1024 <= port <= 65535 or port in (8080, TUNNEL_PORT, PORT):
            raise SystemExit("choose a TCP port between 1024 and 65535")
        px["port"] = port
    sb_install()
    try:
        pwd.getpwnam(SB_USER)
    except KeyError:
        subprocess.run(["useradd", "--system", "--no-create-home",
                        "--shell", "/usr/sbin/nologin", SB_USER], check=True)
    sb_keys(px)
    with open(SB_UNIT, "w") as f:
        f.write(SB_UNIT_TEXT)
    px["enabled"] = True
    save(st)
    proxy_apply(st, restart=True)
    subprocess.run(["systemctl", "enable", "--now", "iptv-duckdns.timer"],
                   capture_output=True)
    cmd_duckdns_update(st)


def cmd_proxy_refresh(st):
    """After an update: rewrite the service file / config if they changed and
    restart the service (no-op when TCP mode was never enabled)."""
    px = proxy_state(st)
    if not px.get("enabled") or not os.path.exists(SB_BIN):
        return
    try:
        old = open(SB_UNIT).read()
    except OSError:
        old = ""
    if old != SB_UNIT_TEXT:
        with open(SB_UNIT, "w") as f:
            f.write(SB_UNIT_TEXT)
    sb_keys(px)
    save(st)
    proxy_apply(st, restart=(old != SB_UNIT_TEXT or not proxy_running()))


def cmd_proxy_disable(st):
    px = proxy_state(st)
    px["enabled"] = False
    save(st)
    subprocess.run(["systemctl", "disable", "--now", "iptv-proxy.service"],
                   capture_output=True)


def proxy_link(px, u, host):
    q = urllib.parse.urlencode({
        "encryption": "none", "flow": "xtls-rprx-vision", "security": "reality",
        "sni": px["sni"], "fp": "chrome", "pbk": px["pub"],
        "sid": px["short_id"], "type": "tcp"})
    return "vless://%s@%s:%d?%s#%s" % (u["uuid"], host, int(px["port"]), q,
                                      urllib.parse.quote("EasyIPTVBox " + u["name"]))


def proxy_profile(px, u, host):
    """sing-box app profile: only the box's address goes through the tunnel,
    the phone's other traffic is untouched."""
    return {
        "log": {"level": "warn"},
        "inbounds": [{"type": "tun", "tag": "tun",
                      "address": ["172.19.0.1/30"], "auto_route": True,
                      "strict_route": False,
                      "route_address": [SERVER_IP + "/32"]}],
        "outbounds": [
            {"type": "vless", "tag": "box", "server": host,
             "server_port": int(px["port"]), "uuid": u["uuid"],
             "flow": "xtls-rprx-vision",
             "tls": {"enabled": True, "server_name": px["sni"],
                     "utls": {"enabled": True, "fingerprint": "chrome"},
                     "reality": {"enabled": True, "public_key": px["pub"],
                                 "short_id": px["short_id"]}}},
            {"type": "direct", "tag": "direct"}],
        "route": {"auto_detect_interface": True, "final": "direct",
                  "rules": [{"ip_cidr": [SERVER_IP + "/32"],
                             "action": "route", "outbound": "box"}]},
    }


def proxy_host(st, override=""):
    return override or (st.get("duckdns", {}).get("domain") or "YOUR-HOME-ADDRESS")


def cmd_proxy_add(st, name, host=""):
    px = proxy_state(st)
    if not px.get("enabled"):
        raise SystemExit("TCP mode is not enabled")
    if not NAME_RE.match(name):
        raise SystemExit("bad name")
    if any(u["name"].lower() == name.lower() for u in px["users"]):
        raise SystemExit("name already used")
    u = {"name": name, "uuid": str(uuid.uuid4()), "created": int(time.time())}
    px["users"].append(u)
    save(st)
    proxy_apply(st)
    h = proxy_host(st, host)
    print(json.dumps({"link": proxy_link(px, u, h),
                      "profile": proxy_profile(px, u, h),
                      "host": h, "port": int(px["port"])}))


def cmd_proxy_remove(st, name):
    px = proxy_state(st)
    px["users"] = [u for u in px["users"] if u["name"] != name]
    save(st)
    if px.get("enabled"):
        proxy_apply(st, restart=True)     # restart: drops the removed device


def cmd_proxy_status(st):
    px = proxy_state(st)
    print(json.dumps({
        "enabled": bool(px.get("enabled")), "running": proxy_running(),
        "port": int(px.get("port", DEFAULT_PROXY_PORT)),
        "installed": os.path.exists(SB_BIN), "sni": px.get("sni", DEFAULT_SNI),
        "host": proxy_host(st),
        "users": [{"name": u["name"]} for u in px.get("users", [])]}))


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    cmd, args = sys.argv[1], sys.argv[2:]
    st = load()
    if cmd == "setup":
        ensure_server(st)
        save(st)
        write_wg_conf(st)
    elif cmd == "enable":
        ensure_server(st)
        st["enabled"] = True
        save(st)
        reload_wg(st)
        subprocess.run(["systemctl", "enable", "--now", "iptv-duckdns.timer"],
                       capture_output=True)
        cmd_duckdns_update(st)
    elif cmd == "disable":
        st["enabled"] = False
        save(st)
        subprocess.run(["systemctl", "disable", "--now", "wg-quick@wg0"],
                       capture_output=True)
        subprocess.run(["systemctl", "disable", "--now", "iptv-duckdns.timer"],
                       capture_output=True)
    elif cmd == "add":
        ensure_server(st)
        cmd_add(st, " ".join(args).strip())
    elif cmd == "remove":
        cmd_remove(st, " ".join(args).strip())
    elif cmd == "status":
        cmd_status(st)
    elif cmd == "set-duckdns":
        dom = args[0].strip().lower() if args else ""
        if dom and not dom.endswith(".duckdns.org"):
            dom += ".duckdns.org"
        token = sys.stdin.read().strip()
        dd = st.get("duckdns", {})
        dd["domain"] = dom
        if token:
            if not re.match(r"^[0-9a-fA-F-]{20,64}$", token):
                raise SystemExit("token looks wrong")
            dd["token"] = token
        st["duckdns"] = dd
        save(st)
        cmd_duckdns_update(st)
    elif cmd == "duckdns-update":
        cmd_duckdns_update(st)
    elif cmd == "proxy-enable":
        cmd_proxy_enable(st, args)
    elif cmd == "proxy-refresh":
        cmd_proxy_refresh(st)
    elif cmd == "proxy-disable":
        cmd_proxy_disable(st)
    elif cmd == "proxy-add":
        cmd_proxy_add(st, args[0].strip() if args else "",
                      args[1].strip() if len(args) > 1 else "")
    elif cmd == "proxy-remove":
        cmd_proxy_remove(st, " ".join(args).strip())
    elif cmd == "proxy-status":
        cmd_proxy_status(st)
    else:
        raise SystemExit("unknown command")


if __name__ == "__main__":
    main()
